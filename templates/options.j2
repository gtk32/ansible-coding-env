" Standard VIM settings 
filetype plugin indent on
syntax on

set expandtab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set smartindent

set number
set relativenumber

set showmatch
set backspace=indent,eol,start
set signcolumn=yes

set noswapfile
set nobackup
set nowritebackup
set undofile
set undodir=~/.vim/undodir

set nohlsearch
set incsearch

set mouse=a
set wrap
